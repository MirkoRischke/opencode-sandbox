{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "microsandbox": {
      "repository": "superradcompany/microsandbox",
      "branch": "v0.7.8",
      "description": "Microsandbox source and documentation matching the CLI and Go SDK version used by this project."
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.local/state/opencode-sandbox/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.local/state/opencode-sandbox",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.local/state/opencode-sandbox/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode-sandbox/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.config/opencode-sandbox",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.config/opencode-sandbox/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode-sandbox/creds",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode-sandbox/creds/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/opencode-sandbox/creds",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/opencode-sandbox/creds/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/opencode-sandbox/creds",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/opencode-sandbox/creds/*",
      "effect": "deny"
    }
  ]
}
