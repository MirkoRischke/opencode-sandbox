{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions"
  ],
  "enabledManagers": ["dockerfile", "docker-compose", "custom.regex", "gomod", "mise", "github-actions"],
  "includePaths": ["Dockerfile", "images/*/Dockerfile", "llm-gateway/compose.yaml", "go.mod", "go.sum", "mise.toml", ".github/workflows/**"],
  "packageRules": [
    {
      "description": "The shared sandbox image is built locally, not pulled from a registry",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["opencode-sandbox"],
      "enabled": false
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["openai/codex"],
      "extractVersion": "^rust-v(?<version>.*)$",
      "versioning": "semver",
      "ignoreUnstable": true
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["github/copilot-cli"],
      "extractVersion": "^v(?<version>.*)$",
      "versioning": "semver",
      "ignoreUnstable": true
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@opencode/cli"],
      "ignoreUnstable": true
    },
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/superradcompany/microsandbox/sdk/go"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["microsandbox"],
      "enabled": false
    },
    {
      "description": "Require manual PostgreSQL major upgrades for the gateway database",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false
}
