{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions"
  ],
  "enabledManagers": ["dockerfile", "docker-compose", "custom.regex", "gomod", "mise", "github-actions"],
  "includePaths": ["Dockerfile", "llm-gateway/compose.yaml", "go.mod", "go.sum", "mise.toml", ".github/workflows/**"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
      "automerge": true
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/superradcompany/microsandbox/sdk/go"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["microsandbox"],
      "enabled": false
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false
}
